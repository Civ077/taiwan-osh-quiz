{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        "nick": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 12" },
        "updatedAt": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },

    "scores": {
      "$mode": {
        ".read": "auth != null",
        ".indexOn": ["score", "date"],
        "$scoreId": {
          ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid",
          ".validate": "newData.hasChildren(['uid','nick','score','correct','n','date','ts'])",
          "uid": { ".validate": "newData.isString()" },
          "nick": { ".validate": "newData.isString() && newData.val().length <= 12" },
          "score": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 30000" },
          "correct": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 50" },
          "n": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 50" },
          "date": { ".validate": "newData.isString() && newData.val().matches(/^\\d{4}-\\d{2}-\\d{2}$/)" },
          "ts": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      }
    },

    "rooms": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('host').val() === auth.uid || data.child('players').child(auth.uid).exists() || !data.child('players').child(auth.uid).exists() && data.child('state').val() === 'waiting')",
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        }
      }
    },

    "lobby": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    }
  }
}
